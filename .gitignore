# Ignore Python cache directories
__pycache__/

# Ignore all directories containing ".egg-info"
*.egg-info/

# Ignore log files, except the *.pt checkpoints inside them. The directories
# themselves must stay un-ignored or git never descends far enough to see the
# files; see the "Logs and cache" block below for the matching rules.
logs/**
!logs/**/
!logs/**/*.pt

# Ignore output files
outputs/**
!outputs/**/
!outputs/**/*.pt
# Exception, tracked by force: outputs/rif_delay holds the 234 scored reports
# behind Section 7.5 of the thesis. It is evidence for published claims, not
# scratch, and experiments/E3/code/seed_table.py reads it from this path. Git is
# the only backup for this work, and the campaign it replaced was lost precisely
# because its artefacts were untracked.

# Archived bulk artifacts: retired logs/ and outputs/ keep the same "bytes stay on
# disk, out of git" rule they had before being moved. Their manifests stay tracked
# so the record of what was retired lives in history.
archive/checkpoints_*/*
!archive/checkpoints_*/MANIFEST.tsv
archive/outputs_retired_*/*
!archive/outputs_retired_*/MANIFEST.tsv
!archive/outputs_retired_*/**/
!archive/outputs_retired_*/**/*.pt

# Ignore files beginning with .nfs
.nfs*

.thumbs/
._*

datasets/


runs/

.vscode/
.svn/
__pycache__/
*.pyc
*.pyo

# Generated LaTeX and local database state
*.aux
*.fdb_latexmk
*.fls
*.synctex.gz
*.toc
*.out
*.bbl
*.blg
*.bcf
*.run.xml
*.db-journal

# Python environments
.env/
.venv/
env/
venv/
miniconda3/
conda/

# Large ML / simulation files
# *.pt and *.pth are deliberately NOT ignored: the trained checkpoints are
# irreplaceable and the repo is their only backup. The promoted ROM policy
# model_7364.pt was lost precisely because this rule kept it out of git.
*.onnx
*.mat
*.h5
*.hdf5
*.npz
*.npy
*.zip
*.tar.gz

# Logs and cache. The bulk stays out of git, but *.pt checkpoints inside these
# trees are kept: they are irreplaceable and this repo is their only backup.
# Re-including needs the directories themselves un-ignored first, or git never
# descends far enough to see the files.
*.log
logs/**
!logs/**/
!logs/**/*.pt
outputs/**
!outputs/**/
!outputs/**/*.pt
runs/
wandb/
.cache/

# Isaac / Omniverse generated files
*.usd~
*.usdc
*.usda
*.sqlite
kit/logs/

# ROM training/export artifacts
kevin_integration/rom_cylinders/checkpoints/*
!kevin_integration/rom_cylinders/checkpoints/.gitkeep
kevin_integration/rom_cylinders/exported*/
kevin_integration/rom_cylinders/results/smoke/
.DS_Store
