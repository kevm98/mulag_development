<mxfile host="app.diagrams.net" agent="thesis" version="24.0.0">
  <diagram id="ra" name="Robust vs adaptive">
    <mxGraphModel dx="1500" dy="820" grid="1" gridSize="10" page="1" pageWidth="1500" pageHeight="820">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="fam" value="&lt;b&gt;Randomized plant family { P(xi) }&lt;/b&gt;&lt;br&gt;xi: bulk modulus, valve gain, leakage, friction, payload (Ch. 4)" style="rounded=1;fillColor=#F1F3F5;strokeColor=#69737D;fontSize=13;" vertex="1" parent="1"><mxGeometry x="600" y="50" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="cardA" value="(a) ROBUST - randomized training only (PPO1-B / PPO2-B)" style="rounded=1;fillColor=#FFFDF9;strokeColor=#C97816;verticalAlign=top;fontStyle=1;fontColor=#C97816;fontSize=14;" vertex="1" parent="1"><mxGeometry x="90" y="230" width="620" height="500" as="geometry"/></mxCell>
        <mxCell id="cardB" value="(b) ADAPTIVE - latent conditioning (PPO2-C, this thesis)" style="rounded=1;fillColor=#F9FCFB;strokeColor=#16847A;verticalAlign=top;fontStyle=1;fontColor=#16847A;fontSize=14;" vertex="1" parent="1"><mxGeometry x="790" y="230" width="620" height="500" as="geometry"/></mxCell>
        <mxCell id="a1" value="Training data pooled over every xi" style="rounded=1;fillColor=#FFFFFF;strokeColor=#C97816;fontSize=13;" vertex="1" parent="1"><mxGeometry x="180" y="316" width="440" height="64" as="geometry"/></mxCell>
        <mxCell id="a2" value="&lt;b&gt;One fixed model f_theta&lt;/b&gt;" style="rounded=1;fillColor=#FFF4E5;strokeColor=#C97816;fontSize=13;" vertex="1" parent="1"><mxGeometry x="180" y="412" width="440" height="64" as="geometry"/></mxCell>
        <mxCell id="a3" value="One compromise response for all plants" style="rounded=1;fillColor=#FFFFFF;strokeColor=#C97816;fontSize=13;" vertex="1" parent="1"><mxGeometry x="180" y="508" width="440" height="64" as="geometry"/></mxCell>
        <mxCell id="a4" value="+ tolerates parameter variation&#10;- optimal nowhere; cannot react to change" style="rounded=1;fillColor=#FFF4E5;strokeColor=#C97816;align=left;spacing=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="180" y="614" width="440" height="86" as="geometry"/></mxCell>
        <mxCell id="b1" value="Recent measured history (0.25 s)" style="rounded=1;fillColor=#FFFFFF;strokeColor=#16847A;fontSize=13;" vertex="1" parent="1"><mxGeometry x="880" y="316" width="440" height="64" as="geometry"/></mxCell>
        <mxCell id="b2" value="&lt;b&gt;AAM estimator -&gt; latent z_hat&lt;/b&gt;&lt;br&gt;teacher latent z(xi) supervises training" style="rounded=1;fillColor=#ECF8F6;strokeColor=#16847A;fontSize=13;" vertex="1" parent="1"><mxGeometry x="880" y="412" width="440" height="64" as="geometry"/></mxCell>
        <mxCell id="b3" value="Conditioned model f_theta( . ; z_hat)" style="rounded=1;fillColor=#FFFFFF;strokeColor=#16847A;fontSize=13;" vertex="1" parent="1"><mxGeometry x="880" y="508" width="440" height="64" as="geometry"/></mxCell>
        <mxCell id="b4" value="+ matches the plant it is actually on&#10;+ re-adapts within fractions of a second" style="rounded=1;fillColor=#ECF8F6;strokeColor=#16847A;align=left;spacing=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="880" y="614" width="440" height="86" as="geometry"/></mxCell>
        <mxCell id="ed1" style="strokeColor=#69737D;strokeWidth=2;" edge="1" parent="1" source="fam" target="cardA"><mxGeometry relative="1" as="geometry"/></mxCell>
