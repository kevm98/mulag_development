{
  "contract": {
    "source_checkpoint": "logs/rsl_rl/ppo4_1_sole/speed_range_2_7_pathfix_v2_idfd/model_promoted_2_7kmh.pt",
    "phase1_initialization": "experiments/RMA_PPO/phase1_privileged_init.pt",
    "base_observation_dim": 66,
