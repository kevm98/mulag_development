    "tau_s": [0.0, 0.12],
    "delay_steps": [0, 3],
    "mass_scale": [0.85, 1.15]
  },
  "phase2": {
    "enabled": false,
    "source": "ppo_on_policy_histories_only",
    "history_ticks": 20,
    "causal_features": ["obs_t", "action_t", "obs_tp1_minus_obs_t"],
    "train_on_classical_dataset": false,
    "hidden_dim": 64
  },
  "phase3": {
    "enabled": false,
    "mode": "AAM_ESTIMATED_FINETUNED",
    "freeze_aam_before_finetune": true,
    "privileged_gate_required": true,
    "mid_episode_switch_eval_required": true
  },
  "runtime_modes": [
    "BASELINE",
    "PRIVILEGED",
    "MEAN_CONTEXT",
    "SHUFFLED_CONTEXT",
    "AAM_ESTIMATED",
    "AAM_FROZEN",
    "AAM_ESTIMATED_FINETUNED"
  ],
  "native_physx": {
    "mass_field": "articulation.data.default_mass",
    "com_field": "articulation.data.default_com_pos_b",
    "surrogate_observation_mass_forbidden": true,
    "surrogate_observation_com_forbidden": true
  },
  "execution_policy": {
    "cpu_preparation_only": true,
    "run_simulation_now": false,
    "collect_data_now": false,
    "train_ppo_now": false,
    "run_gpu_now": false
  }
